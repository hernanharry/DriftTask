{
  "project_name": "Driftask",
  "domain": "CRM Mobile App",
  "theme": "Light",
  "archetype": "Archetype 4: Swiss & High-Contrast",
  "typography": {
    "heading_font": "Outfit",
    "body_font": "DM Sans",
    "scales": {
      "h1": {
        "fontSize": 36,
        "fontWeight": "bold",
        "tracking": -0.5
      },
      "h2": {
        "fontSize": 28,
        "fontWeight": "bold",
        "tracking": -0.3
      },
      "h3": {
        "fontSize": 20,
        "fontWeight": "600",
        "tracking": -0.2
      },
      "body": {
        "fontSize": 16,
        "fontWeight": "normal",
        "tracking": 0,
        "lineHeight": 24
      },
      "small": {
        "fontSize": 14,
        "fontWeight": "normal",
        "tracking": 0.2
      }
    }
  },
  "colors": {
    "background": "#FFFFFF",
    "surface": "#F4F4F5",
    "surface_elevated": "#FAFAFA",
    "primary": "#002FA7",
    "primary_foreground": "#FFFFFF",
    "text_main": "#0A0A0A",
    "text_muted": "#52525B",
    "border": "#E4E4E7",
    "accent_success": "#10B981",
    "accent_warning": "#F59E0B",
    "accent_danger": "#EF4444"
  },
  "spacing_and_layout": {
    "screen_padding": 24,
    "element_gap": 16,
    "border_radius_small": 4,
    "border_radius_medium": 8,
    "border_radius_large": 12
  },
  "component_rules": {
    "cards": {
      "backgroundColor": "#FFFFFF",
      "borderWidth": 1,
      "borderColor": "#E4E4E7",
      "borderRadius": 8,
      "shadow": "none (flat look)"
    },
    "buttons": {
      "backgroundColor": "#002FA7",
      "borderRadius": 4,
      "paddingVertical": 16,
      "paddingHorizontal": 24,
      "alignItems": "center",
      "justifyContent": "center"
    },
    "inputs": {
      "backgroundColor": "#F4F4F5",
      "borderRadius": 4,
      "padding": 16,
      "borderWidth": 1,
      "borderColor": "transparent",
      "focusBorderColor": "#002FA7"
    },
    "slides_and_carousels": {
      "behavior": "Horizontal ScrollView with pagingEnabled=true",
      "indicators": "Dot pagination (active: #002FA7, inactive: #E4E4E7)",
      "visual_cue": "Reveal 10% of the next card to encourage swiping"
    }
  },
